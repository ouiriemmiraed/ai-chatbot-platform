# ============================================================
# Environment Variables — Copy this file to .env and fill in
# ============================================================

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
# CRITICAL: Generate a strong SECRET_KEY (32+ characters)
# Run: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=change-me-generate-a-strong-secret-key

# ----------------------------------------------------------
# OpenRouter LLM API
# ----------------------------------------------------------
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------
# MongoDB Configuration
# ----------------------------------------------------------
# Generate strong password: python -c 'import secrets; print(secrets.token_urlsafe(16))'
MONGO_PASSWORD=change-me-strong-mongo-password
MONGODB_URL=mongodb://admin:${MONGO_PASSWORD}@mongodb:27017
DATABASE_NAME=chatbot_db
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=10

# ----------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ----------------------------------------------------------
# ChromaDB Vector Database
# ----------------------------------------------------------
CHROMA_AUTH_TOKEN=change-me-strong-chroma-token
CHROMA_DB_URL=http://chromadb:8000

# ----------------------------------------------------------
# Hugging Face (for embedding models)
# ----------------------------------------------------------
# Optional — needed only for gated models
HF_TOKEN=

# ----------------------------------------------------------
# RAG Pipeline Tuning
# ----------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_RETRIEVAL_MULTIPLIER=5
# RAG_MIN_SCORE=-100.0
# RAG_CACHE_TTL=300
# RAG_BATCH_SIZE=64

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
# 'development' enables /docs (Swagger), 'production' disables it
ENV=production

# CORS — Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ----------------------------------------------------------
# Cookie Security
# ----------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ----------------------------------------------------------
# Site Info (used in LLM metadata)
# ----------------------------------------------------------
# SITE_URL=http://localhost:3000
# SITE_NAME=Chatbot Project

# ----------------------------------------------------------
# Frontend URL (baked into React at build time)
# ----------------------------------------------------------
REACT_APP_API_URL=http://localhost:8000

# ----------------------------------------------------------
# Docker Networking
# ----------------------------------------------------------
# Set to 'host' if using Docker host networking; default 'bridge'
# DOCKER_NETWORK_MODE=bridge
